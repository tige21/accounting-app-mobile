{
  "expo": {
    "name": "Wallet Watch",
    "slug": "walletwatch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/appstore.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "icon": "./assets/images/appstore.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.walletwatch",
      "buildNumber": "2"
    },
    "android": {
      "icon": "./assets/images/playstore.png",
      "package": "com.walletwatch"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "bdcbfad9-33d0-4c5b-98e0-fc8046ffd3c0"
      }
    }
  }
}
